# ==============================================================================
# AI-Powered Application Deployment Agent - Environment Configuration
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# GitHub API Token (Optional, but strongly recommended to prevent rate limits on public repos)
# Obtain at: https://github.com/settings/tokens (classic or fine-grained with public_repo read access)
GITHUB_TOKEN=

# Vercel Official API Token
# Obtain at: https://vercel.com/account/tokens
# Required to create projects, upload git references, and deploy to Vercel edge/CDN
VERCEL_TOKEN=

# Render Official API Key
# Obtain at: https://dashboard.render.com/u/settings#api-keys
# Required to provision Web Services, background workers, and containerized backends on Render
RENDER_API_KEY=

# LLM Provider Key (Optional: system uses high-precision heuristic planning & diagnosis if omitted)
# Supports Gemini or OpenAI API keys:
LLM_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
